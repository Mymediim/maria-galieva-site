---
const offers: Record<string, { title: string; accent: string; points: string[] }> = {
  'artball': {
    title:'Хотите превратить вашу экспертизу', accent:'в цифровой продукт?',
    points:['Обсудим, кому и чем будет полезен ваш продукт','Разберём, какие части методики можно перенести в приложение','Наметим, с чего начать с учётом вашего бюджета'],
  },
  'avtomatizaciya-rabochego-mesta-myasnika': {
    title:'Устали от ручного', accent:'учёта?',
    points:['Разберём, где теряются данные и время сотрудников','Обсудим, какие операции стоит автоматизировать сначала','Рассмотрим ограничения вашей системы учёта и бюджета'],
  },
  'locapp-pervaya-versiya-prilozheniya': {
    title:'Планируете запустить', accent:'собственное приложение?',
    points:['Обсудим, кому и в какой ситуации нужно приложение','Разберём, какие функции нужны для проверки спроса','Рассмотрим способы заработка и ограничения бюджета'],
  },
  'hmb-bank': {
    title:'Планируете', accent:'редизайн сайта?',
    points:['Разберём, какие задачи бизнеса должен решать сайт','Обсудим, что стоит обновить с учётом вашего бюджета','Рассмотрим, как распределить работу команды и подрядчиков'],
  },
  'banana-traders': {
    title:'Готовите к запуску', accent:'B2B-продукт?',
    points:['Обсудим, кто в компании выбирает, использует и оплачивает продукт','Разберём варианты платного доступа и процесс продаж','Наметим ближайшие шаги к запуску с учётом ресурсов команды'],
  },
  'ommt': {
    title:'Планируете запустить', accent:'мобильное приложение?',
    points:['Разберём рынок, аудиторию и ключевые риски','Выберем объём разработки под ваш бюджет','Определим, какие расчёты нужны для инвесторов'],
  },
  'tactus': {
    title:'Нужна помощь с выпуском', accent:'мобильного приложения?',
    points:['Обсудим, на каком этапе проект и что мешает выпуску','Разберём приоритеты с учётом бюджета или условий гранта','Наметим, что уточнить у команды перед продолжением работ'],
  },
};
const slug = Astro.url.pathname.split('/').filter(Boolean).at(-1) ?? '';
const offer = offers[slug] ?? {
  title:'Нужна помощь', accent:'с продуктом?',
  points:['Разберём вашу задачу','Обсудим ограничения бюджета','Определим ближайший шаг'],
};

---
<section class="case-callback" id="case-request" aria-labelledby="case-request-title">
  <div class="case-callback-inner">
  <div class="case-callback-copy">
    <h2 id="case-request-title" class="case-callback-headline">{offer.title} <span>{offer.accent}</span></h2>
    <p class="case-callback-consultation">Бесплатная первичная консультация</p>
    <ul class="case-callback-benefits">{offer.points.map(point => <li>{point}</li>)}</ul>
  </div>
  <form class="case-callback-form" data-case-callback>
    <label for="case-request-contact">Контакт для связи<span class="case-callback-contact-hint" id="case-contact-hint">Телефон, почта, соцсеть или другой контакт</span><input id="case-request-contact" name="contact" type="text" aria-describedby="case-contact-hint" maxlength="400" required /></label>
    <label for="case-request-comment">С чем нужна помощь?<textarea id="case-request-comment" name="comment" rows="3" maxlength="2000" placeholder="Расскажите о вашей задаче"></textarea></label>
    <label class="case-callback-consent"><input type="checkbox" name="privacy_consent" value="1" required /><span>Даю <a href="/personal-data-consent/" target="_blank" rel="noopener noreferrer">согласие на обработку данных заявки</a> для ответа на мой запрос.</span></label>
    <button type="submit">Оставить заявку</button>
    <p class="case-callback-status" role="status" aria-live="polite" hidden></p>
    <a class="case-callback-alternative" href="https://t.me/Mediim" target="_blank" rel="noopener noreferrer" aria-label="Написать Марии в Telegram" title="Написать в Telegram"><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path fill="currentColor" d="M21.4 3.2 2.8 10.4c-1.3.5-1.3 1.2-.2 1.6l4.8 1.5 1.8 5.5c.2.6.1.8.8.8.5 0 .7-.2 1-.5l2.3-2.2 4.8 3.5c.9.5 1.5.3 1.7-.8l3.1-14.8c.3-1.4-.5-2-1.5-1.8ZM8.2 13.2l10.8-6.8c.5-.3.9-.1.5.2l-8.9 8-.3 3.3-2.1-4.7Z"/></svg></a>
  </form>
</div>
</section>
<script>
  import { bindCaseCallback } from '../scripts/case-callback.mjs';
  document.querySelectorAll<HTMLFormElement>('[data-case-callback]').forEach(bindCaseCallback);
</script>
<style>
@keyframes case-callback-background{from{background-position:0% 50%}to{background-position:100% 50%}}
@media(prefers-reduced-motion:no-preference){.case-callback{animation:case-callback-background 3s ease-in-out infinite alternate}}
.case-callback-copy{align-self:center;min-width:0}
.case-callback-form{color:#102a43}
.case-callback{box-sizing:border-box;width:100%;margin:56px 0 0;padding:56px 0;background:#102a43;background-image:linear-gradient(115deg,#102a43 5%,#214e73 34%,#173b5e 50%,#102a43 70%,#214e73 95%);background-size:230% 100%;background-position:50% 50%;font-family:Inter,"Segoe UI",Arial,sans-serif;color:#fff}
.case-callback-inner{width:min(1240px,calc(100% - 80px));margin-inline:auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.85fr);gap:64px;align-items:center}
.case-callback-benefits{list-style:none;padding:0;margin:26px 0;display:grid;gap:18px}
.case-callback-benefits li{position:relative;padding-left:25px;color:#fff;font-size:19px;font-weight:550;line-height:1.5}
.case-callback-benefits li::before{content:'';position:absolute;left:0;top:.55em;width:7px;height:7px;border-radius:50%;background:#f29d49}
.case-callback h2{color:#fff;font-size:clamp(28px,2.6vw,36px);line-height:1.2;letter-spacing:-.03em;margin:0 0 20px;white-space:normal;text-wrap:wrap}
.case-callback p{font-size:17px;line-height:1.6;color:#fff;margin:0;max-width:500px}.case-callback .case-callback-label{font-size:14px;color:#f6b16f;font-weight:650;margin-bottom:16px}
.case-callback-form{display:grid;gap:16px;padding:26px;background:white;border-radius:var(--card-radius,10px);min-width:0}.case-callback-form>label{display:grid;gap:8px;font-size:15px;font-weight:600;line-height:1.45}.case-callback-form input:not([type=checkbox]),.case-callback-form textarea{box-sizing:border-box;width:100%;min-width:0;padding:12px 14px;min-height:48px;border:1px solid #a7b8c6;border-radius:var(--button-radius,6px);font:16px Inter,"Segoe UI",Arial,sans-serif;color:#102a43;background:#fff}.case-callback-form textarea{resize:vertical;min-height:96px}.case-callback-form .case-callback-consent{display:flex;align-items:flex-start;gap:10px;font-size:14px;font-weight:400;color:#526477}.case-callback-consent input{flex-shrink:0;width:18px;height:18px;margin:2px 0 0;accent-color:#102a43}.case-callback a{color:#173b5e;text-decoration:underline;text-underline-offset:3px}.case-callback-form button{font:600 16px/1.4 Inter,"Segoe UI",Arial,sans-serif;padding:14px 18px;border:1px solid #de7d24;border-radius:var(--button-radius,6px);background:#f29d49;color:#102a43;cursor:pointer}.case-callback-form button:hover{background:#ffb66d}.case-callback-form button:disabled{opacity:.65;cursor:wait}.case-callback-form .case-callback-status{font-size:15px;color:#102a43}.case-callback-alternative{display:inline-flex;align-items:center;justify-content:center;justify-self:center;width:44px;height:44px;border-radius:50%;background:#eaf4fa;color:#229ed9}.case-callback-alternative:hover{background:#d9edf8}.case-callback :is(a,button,input,textarea):focus-visible{outline:3px solid #de7d24;outline-offset:3px}.case-callback [hidden]{display:none}
@media(max-width:800px){.case-callback{width:100%;padding:36px 0;margin:36px 0 0}.case-callback-inner{width:calc(100% - 40px);grid-template-columns:minmax(0,1fr);gap:28px}.case-callback-benefits li{font-size:18px}.case-callback-form{padding:20px}.case-callback h2{color:#fff;font-size:28px}.case-callback h2 br{display:none}.case-callback h2 br:after{content:' '}}
.case-callback .case-callback-headline{font-size:clamp(36px,3.6vw,52px);font-weight:750;line-height:1.08;letter-spacing:-.04em;max-width:650px;margin-bottom:24px;white-space:normal;text-wrap:balance}
.case-callback-headline span{color:#f29d49}
.case-callback .case-callback-consultation{font-size:19px;font-weight:650;line-height:1.45;color:#fff}
@media(max-width:800px){.case-callback .case-callback-headline{font-size:clamp(32px,7vw,44px)}.case-callback .case-callback-consultation{font-size:18px}}
.case-callback-form .case-callback-contact-hint{font-size:13px;line-height:1.45;font-weight:400;color:#526477}
</style>





