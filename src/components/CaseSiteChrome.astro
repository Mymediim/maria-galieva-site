---
import prototypeSource from '../../prototype-desktop.html?raw';
import desktopStyles from '../../desktop-design.css?raw';
const { part } = Astro.props;
const baseStyles = prototypeSource.match(/<style>([\s\S]*?)<\/style>/)?.[1] ?? '';
let markup = part === 'header'
  ? prototypeSource.match(/<header class="site-header">[\s\S]*?<\/header>/)?.[0] ?? ''
  : prototypeSource.match(/<footer class="final"[\s\S]*?<\/footer>/)?.[0] ?? '';
markup = markup.replaceAll('href="#', 'href="/#');
if (part === 'header') markup = markup.replace('<nav class="nav" aria-label="Разделы сайта">', '<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="case-site-nav"><span class="sr-only">Открыть меню</span><span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span></button><nav class="nav" id="case-site-nav" aria-label="Разделы сайта">');
const styles = `@scope (.site-chrome) { ${baseStyles.replaceAll(':root', ':scope')} ${desktopStyles.replaceAll(':root', ':scope')} .reveal { opacity: 1; transform: none; } }`;
---
{part === 'header' && <style is:global set:html={styles} />}
<div class="site-chrome" style="display: contents"><Fragment set:html={markup} /></div>
<script>
  const header = document.querySelector('.site-chrome .site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const close = () => {header?.removeAttribute('data-menu-open'); toggle?.setAttribute('aria-expanded','false');const label=toggle?.querySelector('.sr-only');if(label)label.textContent='Открыть меню';};
  toggle?.addEventListener('click',()=>{if(header?.hasAttribute('data-menu-open')){close();return;}header?.setAttribute('data-menu-open','');toggle.setAttribute('aria-expanded','true');const label=toggle.querySelector('.sr-only');if(label)label.textContent='Закрыть меню';});
  header?.querySelectorAll('nav a').forEach(a=>a.addEventListener('click',close));
  document.addEventListener('keydown',e=>{if(e.key==='Escape')close();});
  window.addEventListener('resize',()=>{if(innerWidth>=1100)close();});
</script>
