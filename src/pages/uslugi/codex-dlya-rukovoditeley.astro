---
import '../../styles/button-shape.css';
import CaseSiteChrome from '../../components/CaseSiteChrome.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import source from '../../../products/codex-for-leaders/research/prototype/index.html?raw';
import '../../../products/codex-for-leaders/research/prototype/style.css';

const route = '/uslugi/codex-dlya-rukovoditeley/';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL ?? Astro.site?.origin ?? '').replace(/\/$/, '');
const canonical = siteUrl + route;
const indexable = import.meta.env.PUBLIC_SITE_INDEXING === 'true' && Boolean(siteUrl);
const title = 'Обучение Codex для руководителей и предпринимателей — Мария Галиева';
const description = '3 индивидуальных занятия в Zoom на задачах вашего бизнеса. Настройте Codex, установите 30+ навыков и автоматизируйте рабочий процесс.';
const socialImage = siteUrl + '/maria-social-1200x630.webp';
const formId = 1798;
const formEndpoint = `https://it-production.dev/wp-json/contact-form-7/v1/contact-forms/${formId}/feedback`;
const body = (source.match(/<body>([\s\S]*?)<\/body>/)?.[1] ?? '')
  .replace(/<script\b[^>]*>[\s\S]*?<\/script>/g, '')
  .replace(/<header>[\s\S]*?<\/header>/, '')
  .replace(/<footer>[\s\S]*?<\/footer>/, '')
  .replaceAll('src="maria-color.png"', 'src="/maria-codex-practicum.webp"')
  .replace('src="../../../../assets/practicum-work-review.webp"', 'src="/practicum-work-review.webp"')
  .replace('data-endpoint=""', `data-endpoint="${formEndpoint}" data-contact-form-id="${formId}"`);
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Course',
      '@id': canonical + '#course',
      url: canonical,
      name: 'ChatGPT и Codex для предпринимателей и руководителей',
      description,
      inLanguage: 'ru',
      provider: { '@type': 'Person', '@id': siteUrl + '/#maria-galieva', name: 'Мария Галиева', url: siteUrl + '/' },
      offers: [
        { '@type': 'Offer', name: 'Базовый', price: 35000, priceCurrency: 'RUB', url: canonical + '#pricing' },
        { '@type': 'Offer', name: 'С сайтом', price: 60000, priceCurrency: 'RUB', url: canonical + '#pricing' },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: siteUrl + '/' },
        { '@type': 'ListItem', position: 2, name: 'Практикум по Codex', item: canonical },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Мария Галиева" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Мария Галиева, наставник практикума" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </head>
  <body>
    <CaseSiteChrome part="header" application />
    <Fragment set:html={body} />
    <CaseSiteChrome part="footer" />
    <CookieConsent showSettings={false} />
    <script>import '../../../products/codex-for-leaders/research/prototype/script.js';</script>
  </body>
</html>

<!-- Материал подготовлен Марией Галиевой | IT Production. Публичные ссылки и авторская подпись отображаются в подвале страницы. -->
