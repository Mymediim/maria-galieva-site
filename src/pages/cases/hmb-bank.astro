---
// Материал подготовлен Марией Галиевой | IT Production
import CaseSiteChrome from '../../components/CaseSiteChrome.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import '../../styles/locapp.css';

const siteUrl = 'https://maria-galieva.ru/';
const canonicalUrl = new URL('cases/hmb-bank/', siteUrl).href;
const pageTitle = 'Редизайн сайта ХМБ Банка за 5 месяцев | Мария Галиева';
const pageDescription = 'Как Мария Галиева собрала требования ХМБ Банка, согласовала концепцию и организовала редизайн сайта. За пять месяцев команда обновила более 75 страниц.';
const socialImage = new URL('cases/hmb-bank/cover.webp', siteUrl).href;
const socialImageAlt = 'Обновлённый сайт ХМБ Банка на компьютере и телефоне';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: 'Редизайн сайта ХМБ Банка за пять месяцев',
      description: pageDescription,
      mainEntityOfPage: canonicalUrl,
      inLanguage: 'ru-RU',
      image: socialImage,
      author: { '@type': 'Person', name: 'Мария Галиева', url: siteUrl },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: 'ХМБ Банк', item: canonicalUrl },
      ],
    },
  ],
};

const booking = 'https://calendar.app.google/4Qmx1NCCWEhLcsV78';
const studio = 'https://it-production.dev/';
const studioCase = new URL('projects/razrabotka-sajta-pod-klyuch-dlya-hakasskij-municzipalnyj-bank-hmb-bank/', studio);
const work = [
  { title: 'Собрала концепцию', text: 'Свела материалы подразделений в одну структуру сайта и упростила подачу продуктов.' },
  { title: 'Определила объём работ', text: 'Помогла выбрать, где хватит общего шаблона, а где нужна отдельная страница. Это помогло уложиться в бюджет.' },
  { title: 'Провела согласование', text: 'Руководители проверили свои разделы. Я следила, чтобы команда вовремя получала материалы и ответы.' },
];
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="description" content={pageDescription} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <title>{pageTitle}</title>
  <meta property="og:type" content="article" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:image:type" content="image/webp" />
  <meta property="og:image:width" content="1080" />
  <meta property="og:image:height" content="540" />
  <meta property="og:image:alt" content={socialImageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={socialImage} />
  <meta name="twitter:image:alt" content={socialImageAlt} />
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</head>
<body>
  <a class="lc-skip" href="#main">К содержанию</a>
  <CaseSiteChrome part="header" />
  <main class="lc" id="main">
    <div class="lc-preview"><a href="/#cases">← Все кейсы</a></div>

    <section class="lc-wrap lc-hero">
      <div class="lc-hero-copy">
        <div class="lc-kicker">Кейс ХМБ Банка</div>
        <h1>Сайт давно пора обновить. <em>Кому поручить проект?</em></h1>
        <p class="lc-lead">Ссылку неловко отправлять клиентам. На сайте старый номер, форма заявки не работает, а разработчики давно ушли. Редизайн снова откладывается, потому что вести его некому.</p>
        <a class="lc-button" href="#contact">Обсудить обновление сайта</a>
      </div>
      <figure class="hmb-cover">
        <img src="/cases/hmb-bank/cover.webp" width="1080" height="540" fetchpriority="high" alt={socialImageAlt} />
        <figcaption>
          <span><strong>5 месяцев</strong> до запуска</span>
          <span><strong>75+ страниц</strong> в новом сайте</span>
        </figcaption>
      </figure>
    </section>

    <section class="lc-section lc-soft hmb-problem" aria-labelledby="problem">
      <div class="lc-wrap lc-split">
        <div>
          <h2 id="problem">Почему банк откладывал редизайн</h2>
          <p class="lc-lead">Банк давно хотел обновить сайт. Сметы превышали бюджет, а готового ТЗ ещё не было.</p>
        </div>
        <div class="hmb-blocker">
          <h3>Выбрали подрядчика. Кто соберёт материалы?</h3>
          <p>Информация лежала в разных местах. За продукты отвечали разные руководители, а собрать материалы для сайта было некому.</p>
        </div>
      </div>
    </section>

    <section class="lc-section lc-dark hmb-work" id="work" aria-labelledby="work-title">
      <div class="lc-wrap hmb-work-layout">
        <div>
          <h2 id="work-title">Как я провела проект от требований до запуска</h2>
          <p>Банк проверял условия продуктов. Я вела согласования и работу по проекту. <a href={studio} target="_blank" rel="noopener noreferrer">IT Production</a> отвечала за дизайн и разработку.</p>
        </div>
        <ol class="hmb-flow">
          {work.map(({ title, text }) => (
            <li><h3>{title}</h3><p>{text}</p></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="lc-section lc-wrap hmb-result" aria-labelledby="result">
      <div class="hmb-result-copy">
        <h2 id="result">Как выглядит новый сайт</h2>
        <p>Клиенты находят нужный продукт и рассчитывают условия вклада. Сотрудники банка сами обновляют параметры расчёта и курсы валют.</p>
        <a class="lc-button hmb-bank-link" href="https://kbhmb.ru/" target="_blank" rel="noopener noreferrer">Перейти на сайт ХМБ Банка</a>
        <a class="lc-text-link" href={studioCase.href} target="_blank" rel="noopener noreferrer">Кейс на сайте IT Production</a>
      </div>
      <figure class="hmb-screen">
        <img src="/cases/hmb-bank/website.webp" width="1062" height="1326" loading="lazy" decoding="async" alt="Главная страница ХМБ Банка с предложениями и калькулятором вкладов" />
        <figcaption>Главная с калькулятором вкладов</figcaption>
      </figure>
    </section>

    <section class="lc-section lc-wrap lc-contact hmb-contact" id="contact" aria-labelledby="contact-title">
      <div>
        <h2 id="contact-title">Обновление сайта можно поручить мне</h2>
        <p class="lc-lead">Помогу определить, что войдёт в ваш бюджет, и проведу проект от требований до запуска.</p>
        <p>С вашей командой, другим подрядчиком или <a href={studio} target="_blank" rel="noopener noreferrer">IT Production</a>.</p>
      </div>
      <div class="lc-contact-action">
        <a class="lc-button" href={booking} target="_blank" rel="noopener noreferrer" data-analytics-event="calendar_click" data-analytics-placement="hmb_case_contact">Записаться на бесплатную встречу</a>
        <span>За 30 минут обсудим, что тормозит проект и что можно поручить мне.</span>
      </div>
    </section>
  </main>
  <CaseSiteChrome part="footer" />
  <CookieConsent />
</body>
</html>

<style>
  .lc-hero {
    padding-bottom: clamp(40px, 6vw, 76px);
  }

  .lc-hero h1 {
    font-size: clamp(37px, 4.6vw, 66px);
    text-wrap: balance;
  }

  .hmb-cover {
    overflow: hidden;
    border-radius: 12px;
    background: #102a43;
  }

  .hmb-cover img, .hmb-screen img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hmb-cover figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    padding: 18px 22px;
    color: #d3e0eb;
    font-size: 14px;
  }

  .hmb-cover strong {
    color: #ffd4ac;
  }

  .hmb-problem {
    padding-block: clamp(36px, 5vw, 64px);
  }

  .hmb-blocker {
    border-inline-start: 2px solid #de7d24;
    padding-inline-start: 20px;
  }

  .hmb-blocker p, .hmb-work-layout h2 + p {
    margin-top: 16px;
  }

  .hmb-work-layout {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1fr);
    gap: clamp(32px, 8vw, 104px);
  }

  .hmb-flow {
    margin: 0;
    padding-inline-start: 24px;
    border-inline-start: 1px solid #a9becf70;
    list-style: none;
  }

  .hmb-flow li {
    position: relative;
    padding-bottom: 24px;
  }

  .hmb-flow li:last-child {
    padding-bottom: 0;
  }

  .hmb-flow li::before {
    position: absolute;
    inset-inline-start: -29px;
    top: .65em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #ffd4ac;
    content: '';
  }

  .hmb-flow p {
    margin-top: 6px;
  }

  .hmb-result {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(26px, 6vw, 80px);
    align-items: center;
  }

  .hmb-result-copy p {
    margin-top: 16px;
    max-width: 420px;
  }

  .hmb-bank-link {
    margin-top: 22px;
    color: #102a43 !important;
    background: #fff;
    border: 1px solid #667d90;
  }

  .hmb-bank-link:hover {
    background: #f4f7fa;
  }

  .hmb-result-copy .lc-text-link {
    display: block;
    width: fit-content;
    margin-top: 16px;
  }

  .hmb-screen img {
    border: 1px solid #dbe3ea;
    border-radius: 9px;
    background: #f4f7fa;
  }

  .hmb-screen figcaption {
    margin-top: 8px;
    color: #617184;
    font-size: 14px;
  }

  .hmb-contact .lc-button {
    background: #a54f15;
  }

  .hmb-contact .lc-button:hover {
    background: #833c0c;
  }

  .lc-contact-action > span {
    text-align: center;
    line-height: 1.5;
    max-width: 270px;
  }

  @media (max-width: 760px) {
    .hmb-work-layout, .hmb-result {
      grid-template-columns: 1fr;
    }
  }
</style>
