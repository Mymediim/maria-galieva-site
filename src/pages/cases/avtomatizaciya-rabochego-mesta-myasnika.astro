---
import '../../styles/myasorubka.css';
import CaseSiteChrome from '../../components/CaseSiteChrome.astro';
import CookieConsent from '../../components/CookieConsent.astro';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL ?? '').replace(/\/$/, '');
const allowIndexing = import.meta.env.PUBLIC_SITE_INDEXING === 'true' && Boolean(siteUrl);
const canonicalUrl = siteUrl ? `${siteUrl}/cases/avtomatizaciya-rabochego-mesta-myasnika/` : '';
const pageTitle = 'Рабочее место мясника: автоматизация учёта | Мария Галиева';
const pageDescription = 'Автоматизация мясных магазинов на примере сети «Мясорубка»: учёт разруба, актуальные остатки в CRM и контроль отклонений. Продуктовый кейс Марии Галиевой.';
const socialImage = siteUrl ? `${siteUrl}/cases/myasorubka/store.webp` : '';
const faq = [
  ['Как автоматизировать рабочее место мясника?', 'Начать с процесса: кто фиксирует вес туши и выход продукции, когда сведения попадают в учёт и кто их проверяет. В этом проекте мяснику дали простой интерфейс для ввода результатов разруба с передачей данных в CRM.'],
  ['Почему в мясном магазине возникают отрицательные складские остатки?', 'В сети «Мясорубка» продукция начинала продаваться до того, как директор вносил данные о разрубе. Продажи отражались в системе раньше поступления готовой продукции. Для другой сети причину нужно проверять отдельно: одинаковый показатель может возникать из-за разных ошибок процесса или учёта.'],
  ['Поможет ли автоматизация выявлять воровство в магазинах?', 'Своевременный учёт помогает сопоставлять движение товара, фактические остатки и выход продукции, чтобы находить расхождения для проверки. Само расхождение не доказывает воровство: причиной могут быть ошибки ввода, потери при обработке или другие обстоятельства. Причину проверяют по операциям и результатам инвентаризации.'],
  ['Чем автоматизация мясных магазинов полезна руководителю сети?', 'Единый порядок ввода данных позволяет получать сведения о работе магазинов в течение дня. Руководитель может проверять операции и отклонения от нормы, а не ждать вечернего переноса записей. Рабочее место из этого кейса внедрено во всех магазинах сети.'],
];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Article', '@id': `${canonicalUrl || '/cases/avtomatizaciya-rabochego-mesta-myasnika/'}#article`, headline: 'Рабочее место мясника для сети магазинов «Мясорубка»', description: pageDescription, inLanguage: 'ru-RU', ...(canonicalUrl ? { url: canonicalUrl, mainEntityOfPage: canonicalUrl, image: [socialImage] } : {}), author: { '@type': 'Person', name: 'Мария Галиева', ...(siteUrl ? { url: `${siteUrl}/`, '@id': `${siteUrl}/#maria-galieva` } : {}) }, about: ['Автоматизация рабочего места мясника', 'Автоматизация мясных магазинов', 'Складской учёт', 'Контроль потерь в розничной сети'] },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Главная', item: `${siteUrl || ''}/` }, { '@type': 'ListItem', position: 2, name: 'Рабочее место мясника', item: canonicalUrl || '/cases/avtomatizaciya-rabochego-mesta-myasnika/' }] },
  ],
};
const booking = 'https://calendar.app.google/4Qmx1NCCWEhLcsV78';
const problems = [
  ['<path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="M3 8v9l9 5 9-5V8M12 13v9"/>', 'В системе нет текущих остатков', 'На витрине продукция есть, а её поступление в учёте ещё не проведено.'],
  ['<path d="M3 3v18h18M7 16v-4m5 4V8m5 8V5"/>', 'Неполная аналитика продаж', 'Продажи и движение товара отражаются в системе в разное время.'],
  ['<path d="M12 3 3 7v5c0 5 9 9 9 9s9-4 9-9V7l-9-4Z"/><path d="M12 8v5m0 3h.01"/>', 'Потери сложнее обнаружить', 'Запаздывающий учёт мешает отличить расхождение в данных от возможной кражи.'],
  ['<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V2h6v2M8 10l2 2 4-4M8 16h8"/>', 'Инвентаризация с расхождениями', 'Фактические остатки сложно сопоставить с данными системы в течение дня.'],
  ['<rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 22h8m-4-4v4M7 9h2m2 0h2m2 0h2M7 13h10"/>', 'Директор занят вводом данных', 'Вечером директор вручную переносит записи мясника в систему.'],
  ['<path d="M12 21s7-6 7-12a7 7 0 0 0-14 0c0 6 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/>', 'Масштабирование требует присутствия', 'Без прозрачного контроля сложнее управлять магазинами в новых городах.'],
];
const screens = [
  ['workshops.webp', '01', 'Выбрать свой цех', 'На стартовом экране сотрудник выбирает цех: разруб, производство, копчение или другой раздел.'],
  ['recipes.webp', '02', 'Найти нужную техкарту', 'Внутри цеха сотрудник выбирает техкарту для нужной продукции.'],
  ['cutting.webp', '03', 'Внести выход продукции', 'Сотрудник указывает вес полученной продукции. На одном экране видны итоговый выход и разница с весом туши.'],
];
const effects = [
  ['01', 'Контроль остатков', 'Информация поступает в систему при выполнении операции, а не накапливается до вечера.'],
  ['02', 'Без повторного ввода', 'Мясник сам вносит данные. Директору не нужно повторно переносить их с листочка.'],
  ['03', 'Результаты операций', 'Выход продукции по операциям помогает оценивать работу сотрудников в течение дня.'],
  ['04', 'Контроль отклонений', 'Выход продукции можно сопоставлять с нормой и разбирать причины расхождений.'],
];
const role = [
  ['Исследовала', 'Расспросила клиента о движении товара и учёте. Выяснила, что данные о разрубе вносят после начала продаж.'],
  ['Предложила решение', 'Предложила вводить данные сразу после разруба силами мясника. Согласовала с клиентом новый порядок работы.'],
  ['Создала прототип', 'Создала прототип интерфейса. Доработала сценарий: убрала лишнее и добавила функции, необходимые для работы сотрудника.'],
  ['Сопроводила разработку', 'Передала прототип в разработку, проверяла реализацию и вносила правки, чтобы интерфейс соответствовал рабочему процессу.'],
  ['Помогла протестировать', 'Участвовала в тестировании и передала компании решение для внедрения в магазинах.'],
];
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="robots" content={allowIndexing ? 'index, follow' : 'noindex, nofollow'} />
  {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
  <meta property="og:type" content="article" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:site_name" content="Мария Галиева" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
  {socialImage && <meta property="og:image" content={socialImage} />}
  <meta property="og:image:alt" content="Магазин сети «Мясорубка» — кейс автоматизации рабочего места мясника" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  {socialImage && <meta name="twitter:image" content={socialImage} />}
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <link rel="icon" href="/favicon.svg" />
</head>
<body>
<a class="skip" href="#main">К содержанию</a>
<CaseSiteChrome part="header" />
<main id="main">
  <nav class="container case-breadcrumbs" aria-label="Хлебные крошки"><a href="/">Главная</a><span aria-hidden="true">/</span><span aria-current="page">Рабочее место мясника</span></nav>
  <section class="hero container" aria-labelledby="title">
    <div class="hero-copy"><div class="eyebrow">Кейс · Автоматизация мясных магазинов</div><h1 id="title">Рабочее место <em>мясника</em> для сети магазинов «Мясорубка»</h1><p class="lead">Товар уже продавался, а данные о разрубе попадали в систему только вечером. Я нашла причину отрицательных остатков и предложила перенести ввод данных на рабочее место мясника.</p><div class="hero-links"><a class="button" href="#solution">Посмотреть решение <span aria-hidden="true">↓</span></a><a class="text-link" href="https://vk.ru/myasorubka" target="_blank" rel="noopener noreferrer">Группа клиента ↗</a></div></div>
    <figure class="hero-photo"><img src="/cases/myasorubka/store.webp" alt="Торговый зал сети «Мясорубка»: полки с продукцией" width="2018" height="1458" fetchpriority="high" /><figcaption><span>Сеть мясных магазинов</span><strong>Складские остатки и расчёт себестоимости</strong></figcaption></figure>
    <div class="hero-meta"><div><span>Моя роль</span><strong>Исследование, прототип, сопровождение</strong></div><div><span>Фокус</span><strong>Своевременный учёт продукции</strong></div><div><span>Реализация</span><strong>Команда IT Production</strong></div></div>
  </section>

  <section class="interview section" id="interview" aria-labelledby="interview-title"><div class="container interview-grid"><div><div class="eyebrow">01 / Найти проблему</div><h2 id="interview-title">Всё началось<br />с одного вопроса</h2><p>Клиент рассказал об отрицательной себестоимости в CRM. Я стала выяснять, в какой момент товар появляется в магазине и когда — в учёте.</p><p class="note">Сокращённая реконструкция разговора по моим воспоминаниям.</p><button class="button outline" id="play-dialogue" type="button" aria-controls="dialogue">Воспроизвести диалог <span aria-hidden="true">▷</span></button></div><div class="chat" id="dialogue"><div class="chat-top"><span class="live-dot"></span> Из интервью с клиентом <span>···</span></div><div class="messages"><div class="message client" data-message><span>Клиент</span><p>У нас в CRM иногда отрицательная себестоимость у продукции появляется.</p></div><div class="message maria" data-message><span>Мария</span><p>В смысле? Отрицательная?</p></div><div class="message client" data-message><span>Клиент</span><p>Ну, у нас идёт продажа товара с отрицательной себестоимостью. Разруб мяса заносится только в конце дня.</p></div><div class="message maria" data-message><span>Мария</span><p>А можете рассказать цепочку действий от начала разруба?</p></div><div class="chat-gap" data-message>··· <span>Разбираемся, как устроен процесс</span></div><div class="message maria" data-message><span>Мария</span><p>То есть после разруба мясник записывает на листочке выход продукции, а директор вечером заносит данные в систему?</p><p>А продукция уже продаётся, хотя её поступление ещё не отражено в системе.</p></div></div><div class="chat-bottom">Причина нашлась в процессе: продажа начиналась раньше, чем директор вносил данные о разрубе.</div></div></div></section>

  <section class="section container" id="gap" aria-labelledby="gap-title"><div class="section-heading"><div><div class="eyebrow">02 / Разобрать процесс</div><h2 id="gap-title">Как мы изменили процесс</h2></div></div><p class="process-intro">Перенесли ввод данных на рабочее место мясника и изменили порядок учёта. Директор освободился от переноса записей и получил данные для контроля в течение дня.</p><div class="process-comparison"><article class="process-version before"><header class="process-caption"><span>До</span><h3>Учёт догоняет продажу</h3></header><ol class="process"><li class=""><span class="step-number">01</span><strong>Тушу берут со склада</strong><span class="arrow" aria-hidden="true">→</span></li><li class=""><span class="step-number">02</span><strong>Мясник выполняет разруб</strong><span class="arrow" aria-hidden="true">→</span></li><li class=""><span class="step-number">03</span><strong>Записывает выход на листочке</strong><span class="arrow" aria-hidden="true">→</span></li><li class=""><span class="step-number">04</span><strong>Продукцию передают на продажу</strong><span class="arrow" aria-hidden="true">→</span></li><li class="critical"><span class="step-number">05</span><strong>Товар продаётся без отражённого поступления</strong><span class="arrow" aria-hidden="true">→</span></li><li class="critical"><span class="step-number">06</span><strong>Вечером директор переносит записи в CRM</strong></li></ol><div class="process-role"><strong>Директор — оператор ввода</strong><p>Данные проходят через бумагу и второго человека. Учёт ждёт до вечера.</p></div></article><article class="process-version after"><header class="process-caption"><span>После</span><h3>Учёт встроен в работу мясника</h3></header><ol class="process"><li class=""><span class="step-number">01</span><strong>Тушу берут со склада</strong><span class="arrow" aria-hidden="true">→</span></li><li class=""><span class="step-number">02</span><strong>Мясник выполняет разруб</strong><span class="arrow" aria-hidden="true">→</span></li><li class="changed"><span class="step-number">03</span><strong>Вносит выход в интерфейс на рабочем месте</strong><span class="arrow" aria-hidden="true">→</span></li><li class="changed"><span class="step-number">04</span><strong>Данные сразу поступают в CRM</strong><span class="arrow" aria-hidden="true">→</span></li><li class=""><span class="step-number">05</span><strong>Продукцию передают на продажу</strong><span class="arrow" aria-hidden="true">→</span></li><li class="changed"><span class="step-number">06</span><strong>Директор проверяет операции и отклонения</strong></li></ol><div class="process-role"><strong>Директор — контролирует результат</strong><p>Данные вводятся один раз, сразу после разруба. Повторный перенос записей больше не нужен.</p></div></article></div><div class="process-takeaway"><span>Трансформация процесса</span><h3>Изменились порядок действий и роль директора</h3><p>Автоматическая передача в CRM — часть решения. Главное изменение: данные фиксирует тот, кто выполняет работу, в момент операции. Директор подключается для проверки результата.</p></div><div class="gap-callout"><span aria-hidden="true">!</span><p><strong>Продажа опережала учёт.</strong> Продавалась продукция, которая ещё не была заведена на склад в системе. Так возникали отрицательные остатки.</p></div><h3 class="subheading">Одна задержка — несколько проблем для бизнеса</h3><div class="problems">{problems.map(([icon, title, text]) => <article><svg class="problem-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icon} /><h4>{title}</h4><p>{text}</p></article>)}</div></section>

  <section class="solution section" id="solution" aria-labelledby="solution-title"><div class="container"><div class="solution-intro"><div class="eyebrow">03 / Продуктовое решение</div><h2 id="solution-title">Внести данные там, где происходит работа</h2><p class="lead">Я предложила создать на рабочем месте мясника простой интерфейс: сотрудник сам вносит данные о разрубе, и они сразу поступают в CRM.</p></div><div class="gallery-heading"><div class="gallery-controls"><button type="button" id="gallery-prev" aria-label="Предыдущий экран">←</button><span id="gallery-count" role="status">1 / 3</span><button type="button" id="gallery-next" aria-label="Следующий экран">→</button></div></div><div class="gallery" id="gallery" tabindex="0" aria-label="Скриншоты рабочего места мясника">{screens.map(([file,num,title,text]) => <figure class="screen"><button class="screen-open" type="button" data-image={`/cases/myasorubka/${file}`} data-title={title} aria-label={`Увеличить: ${title}`}><img src={`/cases/myasorubka/${file}`} alt={title} loading="lazy" width={file==='workshops.webp'?2875:file==='recipes.webp'?2837:2854} height={file==='workshops.webp'?1348:file==='recipes.webp'?1206:1666} /><span class="zoom-label">Рассмотреть ↗</span></button><figcaption><span>{num}</span><div><h4>{title}</h4><p>{text}</p></div></figcaption></figure>)}</div><div class="inline-cta"><p>В вашем процессе тоже есть ручной перенос данных?</p><a class="text-link" href={booking} target="_blank" rel="noopener noreferrer">Разберём вашу задачу ↗</a></div></div></section>

  <section class="effect-band section" id="effect" aria-labelledby="effect-title"><div class="container"><div class="eyebrow">04 / Эффект от внедрения</div><div class="section-heading effect-heading"><h2 id="effect-title">Данные поступают в течение дня</h2><p>Рабочее место внедрено во всех магазинах сети. Директору больше не нужно ждать вечернего ввода, чтобы увидеть движение продукции.</p></div><div class="effects">{effects.map(([num,title,text])=><article><span>{num}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>


  <section class="section container" id="role" aria-labelledby="role-title"><div class="role-grid"><div class="role-intro"><div class="eyebrow">05 / Мой вклад</div><h2 id="role-title">От первого вопроса<br />до передачи<br />на внедрение</h2><p>Я вела продуктовую часть: от поиска причины расхождений до проверки интерфейса и передачи решения компании.</p></div><ol class="role-list">{role.map(([title,text],i)=><li><span>0{i+1}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></div><div class="team-note"><strong>Работа команды IT Production</strong><div><p>Разработчики IT Production реализовали интерфейс и передачу данных в систему. После тестирования компания-клиент внедрила рабочее место в магазинах сети.</p><a class="text-link team-link" href="https://it-production.dev/" target="_blank" rel="noopener noreferrer">Сайт IT Production ↗</a></div></div></section>

  <section class="case-faq section container" aria-labelledby="case-faq-title"><div class="eyebrow">Вопросы руководителей</div><h2 id="case-faq-title">Автоматизация учёта и контроль потерь</h2><div class="case-faq-list">{faq.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
  <section class="contact container" aria-labelledby="contact-title"><div><div class="eyebrow">Обсудим вашу задачу</div><h2 id="contact-title">Нужно автоматизировать бизнес-процесс?</h2><p>На бесплатной встрече обсудим ваш процесс, ручные операции и задержки в учёте. Определим, с чего начать разбор задачи.</p></div><div class="contact-action"><a class="button" href={booking} target="_blank" rel="noopener noreferrer">Записаться на встречу ↗</a><span>Бесплатно · 30 минут</span></div></section>
</main>
<CaseSiteChrome part="footer" />
<CookieConsent />
<dialog id="image-dialog" aria-label="Просмотр интерфейса"><div class="dialog-toolbar"><span id="image-title"></span><button id="close-image" type="button" aria-label="Закрыть изображение">Закрыть ×</button></div><img id="large-image" alt="" /><p>На телефоне можно прокрутить увеличенный экран по горизонтали.</p></dialog>
<script>

  // Animate only when a block enters view; content stays readable without JS.
  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
  const activeAnimations = new Set<Animation>();
  const revealTargets = document.querySelectorAll<HTMLElement>('.hero-copy, .hero-photo, .hero-meta, .interview-grid > div, #gap .section-heading, .process, .gap-callout, .problems article, .solution-intro, .new-process, .gallery, .effect-heading, .effects article, .role-intro, .role-list li, .team-note, .contact');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        observer.unobserve(entry.target);
        if (motionPreference.matches) return;
        const animation = entry.target.animate(
          [{ opacity: .2, transform: 'translateY(14px)' }, { opacity: 1, transform: 'translateY(0)' }],
          { duration: 500, easing: 'cubic-bezier(.2,.65,.3,1)' }
        );
        activeAnimations.add(animation);
        animation.finished.then(() => activeAnimations.delete(animation)).catch(() => activeAnimations.delete(animation));
      });
    }, { threshold: .08 });
    revealTargets.forEach(target => observer.observe(target));
    motionPreference.addEventListener('change', () => { if (motionPreference.matches) activeAnimations.forEach(animation => animation.cancel()); });
    document.addEventListener('focusin', () => activeAnimations.forEach(animation => animation.finish()));
  }
  const play = document.querySelector<HTMLButtonElement>('#play-dialogue');
  const messages = Array.from(document.querySelectorAll<HTMLElement>('[data-message]'));
  let timers: ReturnType<typeof setTimeout>[] = [];
  play?.addEventListener('click', () => {
    timers.forEach(clearTimeout); timers = [];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    messages.forEach(m => m.classList.remove('message-hidden'));
    if (reduced) return;
    messages.forEach(m => m.classList.add('message-hidden'));
    play.textContent = 'Начать заново ↻';

    messages.forEach((m,i) => timers.push(setTimeout(() => {
      m.classList.remove('message-hidden');

    }, i*1800+200)));
  });
  const gallery=document.querySelector<HTMLElement>('#gallery');
  const prev=document.querySelector<HTMLButtonElement>('#gallery-prev');
  const next=document.querySelector<HTMLButtonElement>('#gallery-next');
  const count=document.querySelector('#gallery-count');
  const slides=Array.from(document.querySelectorAll<HTMLElement>('.screen'));
  const current=()=> gallery ? slides.reduce((best,s,i)=>Math.abs(s.offsetLeft-slides[0].offsetLeft-gallery.scrollLeft)<Math.abs(slides[best].offsetLeft-slides[0].offsetLeft-gallery.scrollLeft)?i:best,0):0;
  const update=()=>{const i=current(); if(count)count.textContent=`${i+1} / ${slides.length}`; if(prev)prev.disabled=i===0; if(next)next.disabled=i===slides.length-1;};
  const move=(direction:number)=>{const i=Math.max(0,Math.min(slides.length-1,current()+direction));gallery?.scrollTo({left:slides[i].offsetLeft-slides[0].offsetLeft,behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});};
  prev?.addEventListener('click',()=>move(-1));next?.addEventListener('click',()=>move(1));gallery?.addEventListener('scroll',update,{passive:true});window.addEventListener('resize',update);update();
  gallery?.addEventListener('keydown',e=>{if(e.target!==gallery)return;if(e.key==='ArrowRight'){e.preventDefault();move(1);}if(e.key==='ArrowLeft'){e.preventDefault();move(-1);}});
  const dialog=document.querySelector<HTMLDialogElement>('#image-dialog');
  const large=document.querySelector<HTMLImageElement>('#large-image');
  document.querySelectorAll<HTMLButtonElement>('.screen-open').forEach(button=>button.addEventListener('click',()=>{if(!dialog||!large)return;large.src=button.dataset.image??'';large.alt=button.dataset.title??'';const title=document.querySelector('#image-title');if(title)title.textContent=large.alt;dialog.showModal();}));
  document.querySelector('#close-image')?.addEventListener('click',()=>dialog?.close());
  dialog?.addEventListener('click',event=>{if(event.target===dialog){const r=dialog.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)dialog.close();}});
</script>
</body></html>
