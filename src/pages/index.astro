---
import '../styles/button-shape.css';
import '../../desktop-design.css';
import CaseSiteChrome from '../components/CaseSiteChrome.astro';
import CookieConsent from '../components/CookieConsent.astro';
import prototypeSource from '../../prototype-desktop.html?raw';

const baseStyles = prototypeSource.match(/<style>([\s\S]*?)<\/style>/)?.[1] ?? '';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL ?? '').replace(/\/$/, '');
const allowIndexing = import.meta.env.PUBLIC_SITE_INDEXING === 'true' && Boolean(siteUrl);
const pageTitle = 'Мария Галиева — продуктовый консультант';
const pageDescription = 'Помогаю собственникам бизнеса спроектировать цифровой продукт, разобрать процесс перед автоматизацией и освоить ИИ на реальной рабочей задаче.';
const canonicalUrl = siteUrl ? `${siteUrl}/` : '';
const socialImageUrl = siteUrl ? `${siteUrl}/maria-social-1200x630.webp` : '';
const personId = siteUrl ? `${siteUrl}/#maria-galieva` : '#maria-galieva';
const originalBody = prototypeSource.match(/<body>([\s\S]*?)<\/body>/)?.[1] ?? '';
const clientScript = originalBody.match(/<script>([\s\S]*?)<\/script>/)?.[1] ?? '';
const pageContent = originalBody
  .replace(/<header class="site-header">[\s\S]*?<\/header>/, '')
  .replace(/<footer class="final"[^>]*>[\s\S]*?<\/footer>/, '')
  .replace(/<script>[\s\S]*?<\/script>/, '')
  .replaceAll('src="assets/', 'src="/');

---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={allowIndexing ? 'index, follow' : 'noindex, nofollow'} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Мария Галиева" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Мария Галиева — продуктовый консультант и основатель IT Production" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'ProfilePage',
        '@id': canonicalUrl ? `${canonicalUrl}#profile` : '#profile',
        name: pageTitle,
        description: pageDescription,
        url: canonicalUrl || undefined,
        mainEntity: {
          '@id': personId,
          '@type': 'Person',
          name: 'Мария Галиева',
          jobTitle: 'Продуктовый консультант',
          email: 'mailto:hello@it-production.dev',
          image: siteUrl ? `${siteUrl}/maria-hero-900.webp` : undefined,
          url: canonicalUrl || undefined,
          sameAs: ['https://t.me/Mediim'],
          worksFor: {
            '@type': 'Organization',
            name: 'IT Production',
            url: 'https://it-production.dev/',
          },
        },
      })}
    ></script>
    <style is:global set:html={baseStyles}></style>
  </head>
  <body>
    <CaseSiteChrome part="header" />
    <Fragment set:html={pageContent} />
    <CaseSiteChrome part="footer" />
    <CookieConsent />
    <script>import '../scripts/cases-carousel';</script>
    <script is:inline set:html={clientScript}></script>
  </body>
</html>
